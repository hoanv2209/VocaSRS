@model PracticeRequestModel
@using System

@{
	ViewData["Title"] = "Flashcards";
	PracticeResponseModel vocabulary = ViewBag.Vocabulary;
	string foreignWord = vocabulary?.ForeignWord ?? "";
}

<style>
	.fc-page {
		--fc-text: #172033;
		--fc-muted: #8791a5;
		--fc-primary: #5b5ce2;
		--fc-border: #e9ebf3;
		width: 100%;
		max-width: 820px;
		margin: 0 auto;
		padding: 36px 24px 48px;
		color: var(--fc-text);
		font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
	}

		.fc-page * {
			box-sizing: border-box;
		}

	/* Header */
	.fc-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 16px;
		margin-bottom: 34px;
	}

	.fc-brand {
		display: flex;
		align-items: center;
		gap: 12px;
	}

	.fc-brand-icon {
		display: grid;
		place-items: center;
		width: 46px;
		height: 46px;
		border-radius: 15px;
		background: #eeeeff;
		color: var(--fc-primary);
		font-size: 23px;
	}

	.fc-brand-title {
		margin: 0;
		font-size: 21px;
		font-weight: 800;
		letter-spacing: -0.6px;
	}

	.fc-brand-subtitle {
		margin: 4px 0 0;
		color: var(--fc-muted);
		font-size: 13px;
	}

	.fc-status {
		display: inline-flex;
		align-items: center;
		gap: 7px;
		padding: 9px 13px;
		border: 1px solid var(--fc-border);
		border-radius: 999px;
		background: #fff;
		color: #667085;
		font-size: 12px;
		font-weight: 700;
		white-space: nowrap;
	}

	.fc-status-dot {
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: #22c55e;
	}

	/* Introduction */
	.fc-intro {
		margin-bottom: 25px;
		text-align: center;
	}

	.fc-eyebrow {
		margin: 0 0 10px;
		color: var(--fc-primary);
		font-size: 11px;
		font-weight: 800;
		letter-spacing: 2px;
		text-transform: uppercase;
	}

	.fc-heading {
		margin: 0;
		font-size: clamp(25px, 4vw, 34px);
		font-weight: 800;
		letter-spacing: -1px;
	}

	.fc-description {
		margin: 10px 0 0;
		color: var(--fc-muted);
		font-size: 14px;
		line-height: 1.7;
	}

	/* Flashcard */
	.fc-scene {
		height: 350px;
		perspective: 1400px;
		cursor: pointer;
		outline: none;
		-webkit-tap-highlight-color: transparent;
	}

		.fc-scene:focus-visible {
			border-radius: 26px;
			outline: 3px solid #a5b4fc;
			outline-offset: 5px;
		}

	.fc-card {
		position: relative;
		width: 100%;
		height: 100%;
		transform-style: preserve-3d;
		transition: transform 0.65s cubic-bezier(.2, .75, .25, 1);
	}

		.fc-card.is-flipped {
			transform: rotateY(180deg);
		}

	.fc-face {
		position: absolute;
		inset: 0;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		padding: 35px 28px;
		overflow: hidden;
		border: 1px solid rgba(255, 255, 255, .85);
		border-radius: 26px;
		backface-visibility: hidden;
		-webkit-backface-visibility: hidden;
		text-align: center;
	}

	.fc-face-front {
		background: radial-gradient(ellipse at 10% 0%, #e8e9ff 0%, transparent 43%), radial-gradient(ellipse at 100% 100%, #dff5ff 0%, transparent 42%), linear-gradient(135deg, #ffffff, #f8f9ff);
		box-shadow: 0 24px 60px rgba(73, 80, 150, .10), 0 3px 12px rgba(31, 41, 55, .04);
	}

	.fc-face-back {
		transform: rotateY(180deg);
		background: radial-gradient(ellipse at 100% 0%, #c9f7e5 0%, transparent 45%), linear-gradient(135deg, #ffffff, #f0fdf7);
		box-shadow: 0 24px 60px rgba(22, 163, 74, .10), 0 3px 12px rgba(31, 41, 55, .04);
	}

	.fc-language {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		margin-bottom: 28px;
		padding: 8px 13px;
		border: 1px solid rgba(91, 92, 226, .12);
		border-radius: 999px;
		background: rgba(255, 255, 255, .75);
		color: #6265c9;
		font-size: 11px;
		font-weight: 800;
		letter-spacing: 1.5px;
		text-transform: uppercase;
	}

	.fc-face-back .fc-language {
		border-color: rgba(22, 163, 74, .15);
		color: #16834a;
	}

	.fc-word {
		max-width: 100%;
		margin: 0;
		color: #20243a;
		font-size: clamp(32px, 6vw, 48px);
		font-weight: 800;
		line-height: 1.25;
		letter-spacing: -1.2px;
		overflow-wrap: anywhere;
	}

	.fc-face-back .fc-word {
		color: #147a47;
		font-size: clamp(27px, 5vw, 40px);
	}

	.fc-divider {
		width: 42px;
		height: 4px;
		margin-top: 23px;
		border-radius: 99px;
		background: #c9caff;
	}

	.fc-face-back .fc-divider {
		background: #a7ebc5;
	}

	.fc-flip-hint {
		position: absolute;
		bottom: 24px;
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 7px;
		color: #9198aa;
		font-size: 12px;
	}

	/* Buttons */
	.fc-actions {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 14px;
		margin-top: 25px;
	}

	.fc-action {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 9px;
		min-width: 0;
		min-height: 60px;
		padding: 13px 10px;
		border: 1px solid transparent;
		border-radius: 16px;
		font: inherit;
		font-size: 15px;
		font-weight: 750;
		cursor: pointer;
		transition: transform .18s ease, box-shadow .18s ease, background .18s ease;
	}

		.fc-action:hover:not(:disabled) {
			transform: translateY(-3px);
		}

		.fc-action:active:not(:disabled) {
			transform: translateY(0);
		}

		.fc-action:focus-visible {
			outline: 3px solid #a5b4fc;
			outline-offset: 3px;
		}

		.fc-action:disabled {
			opacity: .6;
			cursor: wait;
		}

	.fc-action-icon {
		display: grid;
		place-items: center;
		width: 29px;
		height: 29px;
		flex-shrink: 0;
		border-radius: 10px;
		font-size: 15px;
	}

	.fc-btn-learn {
		border-color: #f3dfb5;
		background: #fffaf0;
		color: #a16207;
	}

		.fc-btn-learn .fc-action-icon {
			background: #ffedc2;
		}

		.fc-btn-learn:hover:not(:disabled) {
			background: #fff4d9;
			box-shadow: 0 8px 20px rgba(161, 98, 7, .08);
		}

	.fc-btn-review {
		border-color: #d8dcff;
		background: #f3f4ff;
		color: #4f46c7;
	}

		.fc-btn-review .fc-action-icon {
			background: #e1e3ff;
		}

		.fc-btn-review:hover:not(:disabled) {
			background: #e9eaff;
			box-shadow: 0 8px 20px rgba(79, 70, 199, .10);
		}

	.fc-btn-remembered {
		border-color: #c4ecd5;
		background: #f0fdf4;
		color: #15803d;
	}

		.fc-btn-remembered .fc-action-icon {
			background: #d5f7e1;
		}

		.fc-btn-remembered:hover:not(:disabled) {
			background: #dcfce7;
			box-shadow: 0 8px 20px rgba(21, 128, 61, .09);
		}

	.fc-footer {
		margin-top: 22px;
		color: #9aa1b2;
		font-size: 12px;
		line-height: 1.8;
		text-align: center;
	}

	.fc-key {
		display: inline-block;
		margin: 0 3px;
		padding: 2px 7px;
		border: 1px solid #e2e5ed;
		border-bottom-width: 2px;
		border-radius: 5px;
		background: #fff;
		color: #697386;
		font-size: 11px;
		font-weight: 700;
	}

	.fc-empty {
		padding: 70px 24px;
		border: 1px solid var(--fc-border);
		border-radius: 24px;
		background: #fff;
		text-align: center;
		box-shadow: 0 15px 40px rgba(31, 41, 55, .04);
	}

	.fc-empty-icon {
		margin-bottom: 18px;
		font-size: 48px;
	}

	.fc-empty h2 {
		margin: 0 0 10px;
		font-size: 25px;
	}

	.fc-empty p {
		margin: 0;
		color: var(--fc-muted);
	}

	@@media (max-width: 560px) {
		.fc-page {
			padding: 22px 14px 32px;
		}

		.fc-header {
			margin-bottom: 28px;
		}

		.fc-brand-icon {
			width: 40px;
			height: 40px;
			border-radius: 12px;
		}

		.fc-brand-title {
			font-size: 17px;
		}

		.fc-brand-subtitle {
			font-size: 11px;
		}

		.fc-status {
			padding: 8px 10px;
			font-size: 10px;
		}

		.fc-scene {
			height: 300px;
		}

		.fc-face {
			padding: 24px 18px;
			border-radius: 22px;
		}

		.fc-actions {
			gap: 8px;
			margin-top: 18px;
		}

		.fc-action {
			flex-direction: column;
			gap: 5px;
			min-height: 78px;
			padding: 10px 4px;
			border-radius: 13px;
			font-size: 12px;
		}

		.fc-action-icon {
			width: 27px;
			height: 27px;
		}

		.fc-footer {
			margin-top: 18px;
		}
	}

	@@media (prefers-reduced-motion: reduce) {
		.fc-card,
		.fc-action {
			transition: none;
		}
	}
</style>

<div class="fc-page">

	@if (vocabulary == null)
	{
		<section class="fc-empty">
			<div class="fc-empty-icon">📚</div>
			<h2>Chưa có từ vựng</h2>
			<p>Hiện tại chưa có từ vựng để học. Hãy quay lại sau nhé!</p>
		</section>
	}
	else
	{
		<header class="fc-header">
			<div class="fc-brand">
				<div class="fc-brand-icon">✦</div>
				<div>
					<h1 class="fc-brand-title">Word Cards</h1>
					<p class="fc-brand-subtitle">Learn a little every day</p>
				</div>
			</div>

			<div class="fc-status">
				<span class="fc-status-dot"></span>
				Đang học
			</div>
		</header>

		<section class="fc-intro">
			<p class="fc-eyebrow">Vocabulary practice</p>
			<h2 class="fc-heading">Hôm nay học từ gì?</h2>
			<p class="fc-description">
				Hãy thử nhớ nghĩa trước khi lật thẻ nhé.
			</p>
		</section>

		<form id="flashcardForm"
			  asp-controller="Vocabulary"
			  asp-action="Flashcard"
			  method="post">

			@Html.AntiForgeryToken()

			<input type="hidden"
				   name="Id"
				   value="@vocabulary.Id" />

			<input type="hidden"
				   name="PracticeStatus"
				   id="practiceStatusInput"
				   value="" />

			<div class="fc-scene"
				 id="flashcardScene"
				 role="button"
				 tabindex="0"
				 aria-label="Lật thẻ từ vựng">

				<div class="fc-card" id="flashcard">

					<div class="fc-face fc-face-front">
						<div class="fc-language">
							<span>🇬🇧</span>
							English
						</div>

						<h3 class="fc-word">@vocabulary.ForeignWord</h3>

						<div class="fc-divider"></div>

						<div class="fc-flip-hint">
							<span>↻</span>
							Nhấn để xem nghĩa
						</div>
					</div>

					<div class="fc-face fc-face-back">
						<div class="fc-language">
							<span>🇻🇳</span>
							Tiếng Việt
						</div>

						<h3 class="fc-word">@vocabulary.NativeWord</h3>

						<div class="fc-divider"></div>

						<div class="fc-flip-hint">
							<span>↻</span>
							Bạn đã nhớ từ này chưa?
						</div>
					</div>

				</div>
			</div>

			<div class="fc-actions">

				<button type="submit"
						class="fc-action fc-btn-learn"
						data-status="1">
					<span class="fc-action-icon">📖</span>
					<span>Học</span>
				</button>

				<button type="submit"
						class="fc-action fc-btn-review"
						data-status="2">
					<span class="fc-action-icon">🔄</span>
					<span>Ôn tập</span>
				</button>

				<button type="submit"
						class="fc-action fc-btn-remembered"
						data-status="3">
					<span class="fc-action-icon">✓</span>
					<span>Đã nhớ</span>
				</button>

			</div>

		</form>

		<div class="fc-footer">
			Nhấn vào thẻ hoặc dùng
			<span class="fc-key">Space</span>
			để lật thẻ.
		</div>
	}

</div>

<script>
	(() => {
		const scene = document.getElementById("flashcardScene");
		const card = document.getElementById("flashcard");
		const form = document.getElementById("flashcardForm");
		const practiceStatusInput =
			document.getElementById("practiceStatusInput");

		const foreignWord = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(foreignWord));

		if (!scene || !card || !form || !practiceStatusInput) {
			return;
		}

		let isSubmitting = false;

		// Flip card
		function flipCard() {
			if (isSubmitting) return;
			speakWord(foreignWord);
			card.classList.toggle("is-flipped");
		}

		scene.addEventListener("click", flipCard);

		scene.addEventListener("keydown", event => {
			if (event.code !== "Space" && event.code !== "Enter") {
				return;
			}

			event.preventDefault();

			if (event.repeat) return;

			flipCard();
		});

		// Space flips the card when focus is on the page background.
		document.addEventListener("keydown", event => {
			if (event.code !== "Space" || event.repeat) {
				return;
			}

			const target = event.target;

			if (target !== document.body &&
				target !== document.documentElement) {
				return;
			}

			event.preventDefault();
			flipCard();
		});

		// Set PracticeStatus based on the selected button.
		form.querySelectorAll("[data-status]").forEach(button => {
			button.addEventListener("click", () => {
				practiceStatusInput.value = button.dataset.status;
			});
		});

		// Prevent duplicate submissions.
		form.addEventListener("submit", event => {
			if (isSubmitting) {
				event.preventDefault();
				return;
			}

			if (!practiceStatusInput.value) {
				event.preventDefault();
				return;
			}

			isSubmitting = true;

			form.querySelectorAll("button[type='submit']").forEach(button => {
				button.disabled = true;
			});
		});
	})();
</script>
```