
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - VocaSRS</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/VocaSRS.styles.css" asp-append-version="true" />
</head>
<body>
    @{
        var controller = ViewContext.RouteData.Values["controller"]?.ToString();
        var action = ViewContext.RouteData.Values["action"]?.ToString();

        bool isHome = controller == "Home" && action == "Index";
        bool isVocabulary = controller == "Vocabulary" && action == "Index";
        bool isPractice = controller == "Vocabulary" && action == "Practice";
    }

    <header class="site-header">
        <nav class="navbar navbar-expand-md site-navbar">
            <div class="container">
                <a class="navbar-brand site-brand"
                   asp-controller="Home" asp-action="Index">
                    <span class="brand-mark">V.</span>
                    <span>vocasrs</span>
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#siteNavigation"
                        aria-controls="siteNavigation"
                        aria-expanded="false"
                        aria-label="Mở menu">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="siteNavigation">
                    <ul class="navbar-nav ms-auto site-nav">
                        <li class="nav-item">
                            <a class="nav-link @(isHome ? "active" : "")"
                               asp-controller="Home"
                               asp-action="Index">
                                Tổng quan
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link @(isVocabulary ? "active" : "")"
                               asp-controller="Vocabulary"
                               asp-action="Index">
                                Từ vựng
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link nav-link-practice @(isPractice ? "active" : "")"
                               asp-controller="Vocabulary"
                               asp-action="Practice">
                                Luyện tập
                                <span class="practice-arrow">↗</span>
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main class="site-main">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container footer-content">
            <span><strong>vocasrs</strong> · Học một chút mỗi ngày.</span>
            <span>@DateTime.Now.Year</span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery-3.6.0.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.responsivevoice.org/responsivevoice.js?key=XZFcTIAF"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
